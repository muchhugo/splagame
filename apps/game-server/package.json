    "@colyseus/core": "0.18.16",
    "@colyseus/ws-transport": "0.18.3",
    "drizzle-orm": "0.45.3",
    "express": "^5.2.1",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@borrifo/test-utils": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "^5.0.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
