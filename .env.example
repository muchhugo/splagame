# =====================================================================
# Borrifo — laboratório de Atividades. Copie para .env (ou rode
# `pnpm setup:env`, que gera segredos locais aleatórios).
# NUNCA coloque segredos reais neste arquivo nem faça commit do .env.
# =====================================================================

# ---- Segredos de DESENVOLVIMENTO (privados; nunca valem em produção) ----
# Assinatura HS256 das credenciais de partida emitidas pelo backend do laboratório.
DEV_MATCH_CREDENTIAL_SECRET=
# Assinatura do cookie de sessão de desenvolvimento do shell.
LAB_SESSION_SECRET=

# ---- Servidor de partidas (privado) ----
GAME_SERVER_PORT=2567
# dev-hs256 (laboratório) | jwks (host real; exige MATCH_CREDENTIAL_JWKS_URL e MATCH_CREDENTIAL_ISSUER)
MATCH_AUTH_MODE=dev-hs256
MATCH_CREDENTIAL_JWKS_URL=
MATCH_CREDENTIAL_ISSUER=
# Origens de navegador aceitas no matchmaking/WebSocket (origem do jogo).
GAME_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROUND_DURATION_SECONDS=180
RESULTS_FILE=data/results.jsonl
LOG_LEVEL=info

# ---- Shell do laboratório / host de desenvolvimento (privado) ----
# URL da Atividade embutida no iframe (origem separada do host).
ACTIVITY_URL=http://localhost:5173/
# URL pública do servidor de partidas, repassada ao jogo junto com a credencial.
GAME_SERVER_PUBLIC_URL=http://localhost:2567
# Rota standalone do jogo (fora do iframe) pede credencial a este backend. 1 = habilitado (somente dev).
LAB_ENABLE_STANDALONE=1
# Origem do jogo autorizada a chamar o endpoint standalone (CORS).
LAB_GAME_ORIGIN=http://localhost:5173

# ---- LiveKit (opcional; privado) ----
# Sem estes valores o host mostra "voz não configurada neste ambiente".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Cliente do jogo (PÚBLICO: embutido no bundle; nada secreto aqui) ----
VITE_GAME_SERVER_URL=http://localhost:2567
# Origens de host autorizadas a embutir e conversar com a Atividade.
VITE_ALLOWED_HOST_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Backend do laboratório usado pela rota standalone de desenvolvimento.
VITE_LAB_BACKEND_URL=http://localhost:3000
